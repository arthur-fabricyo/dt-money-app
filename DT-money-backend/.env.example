# JWT da API legada no modo de desenvolvimento local.
APP_SCRETET_KEY=

# Optional Wi-Fi IPv4 address for testing from a physical Android device.
# DT_MONEY_HOST=192.168.1.42

# API de sincronização hospedada. Configure no Render para o banco de teste.
# APP_SECRET_KEY deve ter pelo menos 32 caracteres.
# APP_SECRET_KEY=
# TURSO_DATABASE_URL=libsql://nome-do-banco-organizacao.turso.io
# TURSO_AUTH_TOKEN=

# Alternativa local da API de sincronização, com SQLite temporário e APP_SECRET_KEY.
# DT_MONEY_SYNC_SQLITE_URL=file:./local-sync-test.db

# Backup no servidor. Use um bucket privado e um prefixo isolado no teste.
# BACKUP_TRIGGER_TOKEN=
# BACKUP_AGE_RECIPIENT=age1...
# R2_ACCOUNT_ID=
# R2_BUCKET=dt-money-backups-test
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BACKUP_PREFIX=dt-money/test/backups/
